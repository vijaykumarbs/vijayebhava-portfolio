{
  "name": "vijayebhava-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:output": "node scripts/check-no-placeholders.mjs",
    "check:links": "linkinator out --recurse --check-fragments --skip 'https://vijayebhava\\.com'",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "new-post": "node scripts/new-post.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run build && npm run check:output"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "linkinator": "^8.1.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
